# 클러스터 인증서가 담긴 파일. 절대 커밋하지 마라.
kubeconfig
kubeconfig-*
*.kubeconfig

# ansible-vault 비번을 파일로 관리할 경우
.vault_pass
vault_pass.txt
*.vault_pass

# vault 로 암호화한 변수 파일은 커밋해도 되지만,
# 암호화 전 평문을 따로 두는 경우를 대비
*vault*.plain.yml
*.decrypted.yml

# 인벤토리 (실제 IP/계정). .example 템플릿만 커밋한다.
inventory*.ini
hosts.local
!*.example

# fetch 로 서버에서 받아온 파일들이 쌓이는 기본 경로
fetched/

# 로컬에서 받은 collection/role
collections/
roles/external/

# uv 가상환경 (uv.lock 은 커밋한다 — 버전 재현성)
.venv/

# ansible 실행 중 생기는 로컬 캐시
.ansible/

# 실행 로그 (-v 출력을 리다이렉트하면 비번/토큰이 섞일 수 있다)
*.log
*.retry

# 에디터/OS
__pycache__/
.DS_Store
.idea/
.vscode/
*.swp
