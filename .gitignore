# 클러스터 인증서가 담긴 파일. 절대 커밋하지 마라.
kubeconfig
kubeconfig-*
*.kubeconfig

# ansible-vault 비번을 파일로 관리할 경우
.vault_pass
vault_pass.txt
*.vault_pass

# vault 로 암호화한 변수 파일은 커밋해도 되지만,
# 암호화 전 평문을 따로 두는 경우를 대비
*vault*.plain.yml
*.decrypted.yml

# 인벤토리 (실제 IP/계정). .example 템플릿만 커밋한다.
inventories/**/*.yml
inventories/**/*.yaml
inventories/**/*.ini
!*.example

# fetch 로 서버에서 받아온 파일들이 쌓이는 기본 경로
fetched/

# collections/ 는 커밋한다 (vendoring).
# 배포 대상 온프레미스는 인터넷이 안 되므로, 레포를 통째로 옮기면
# ansible-galaxy 없이 바로 실행되도록 collection 을 함께 넣어둔다.
# 용량 376K, 파일 47개.

# roles/ 는 쓰지 않는다 (collection 이 role 을 내장한다)
roles/

# uv 가상환경 (uv.lock 은 커밋한다 — 버전 재현성)
.venv/

# ansible 실행 중 생기는 로컬 캐시
.ansible/

# 실행 로그 (-v 출력을 리다이렉트하면 비번/토큰이 섞일 수 있다)
*.log
*.retry

# 에디터/OS
__pycache__/
.DS_Store
.idea/
.vscode/
*.swp
