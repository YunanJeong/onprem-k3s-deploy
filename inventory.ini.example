# ── 인벤토리 ─────────────────────────────────────────────────────────
# 본업: "누구에게" 실행할지 (호스트 목록 + 그룹 구조 + 접속정보)
# 부업: 변수도 담을 수 있다 ([그룹:vars] 섹션)
#
# 파일 이름은 자유다. ansible.cfg 의 inventory= 로 경로를 지정하니까.
#
# 그룹명(k3s, k3s_server, k3s_agent)과 호스트 별명(node1...)은
# 전부 내가 지은 라벨이다. Ansible 기능과 무관하고 아무거나 가능하다.
# 단, site.yml 의 hosts: 와 이름이 일치해야 한다.
#
# ansible_ 로 시작하는 것만 Ansible 내장 예약어다 (이름 변경 불가).
#
# 템플릿이다. 복사해서 쓴다 (inventory.ini 는 커밋되지 않는다):
#   cp inventory.ini.example inventory.ini
# ────────────────────────────────────────────────────────────────────

# k3s 컨트롤플레인. 이 playbook은 server 1대 구성을 전제로 한다.
# (HA = server 3대 + embedded etcd 는 미지원. README 참고)
[k3s_server]
node1 ansible_host=10.0.0.11

# 워커 노드. 필요한 만큼 줄을 추가하면 된다. 0대여도 동작한다(싱글노드).
[k3s_agent]
node2 ansible_host=10.0.0.12
node3 ansible_host=10.0.0.13

# 위 두 그룹을 k3s 라는 상위 그룹으로 묶는다 (전 노드 공통 작업용)
[k3s:children]
k3s_server
k3s_agent

# ── 변수 ────────────────────────────────────────────────────────────
# 지금은 개수가 적으니 여기 둔다.
# 변수가 10개를 넘거나 리스트/중첩이 필요해지면 group_vars/k3s.yml 로 옮긴다.
# (INI는 문자열만 담을 수 있고, group_vars 쪽이 우선순위가 높다)
[k3s:vars]

# --- 접속 정보 (ansible_ 예약어) ---
ansible_user=myuser
# 비번은 여기 적지 마라. ansible.cfg 의 ask_pass/become_ask_pass 로 물어본다.
# 호스트마다 비번이 다르면 ansible-vault 를 써라 (README 참고).

# 리모트 python 경로. Ubuntu/Debian은 자동탐지되니 보통 불필요.
# 문제 생기면 주석 해제:
# ansible_python_interpreter=/usr/bin/python3

# --- 설치 버전 (실제 사용 전에 최신 버전 확인해서 갱신할 것) ---
# https://github.com/k3s-io/k3s/releases
k3s_version=v1.31.5+k3s1
# https://github.com/derailed/k9s/releases
k9s_version=v0.32.7

# --- 토글 ---
# docker는 k3s와 무관하다 (k3s는 containerd를 쓴다). 이미지 빌드용.
# 필요 없으면 false 로 바꿔라.
install_docker=true

# server 노드에 helm / k9s 를 설치할지
# (kubectl 은 k3s 심볼릭링크로 항상 만들어진다 — 이 토글과 무관)
install_cli_tools=true

# 내 PC로 kubeconfig 를 가져올지 (서버에 SSH 붙어서 쓸 거면 false)
fetch_kubeconfig=true
