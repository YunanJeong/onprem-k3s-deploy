---
# ── 용례: k3s server 3대 HA (embedded etcd) ──────────────────────────
#
#   cp inventories/ha/hosts.yml.example inventories/ha/hosts.yml
#   uv run ansible-playbook k3s.orchestration.site -i inventories/ha/hosts.yml
#
# 아래에서 "collection" 은 공식 k3s.orchestration (k3s-io/k3s-ansible) 을 말한다.
#
# 그룹 이름(k3s_cluster / server / agent)은 collection 이 요구하는 고정 이름이다.
# 바꾸면 동작하지 않는다.
#
# HA 전환 토글은 없다. server 그룹에 호스트가 2대 이상이면 collection 이
# 자동으로 embedded etcd HA 로 구성한다. 첫 번째 호스트가 cluster-init 을
# 맡고 나머지가 합류하는 것도 collection 이 처리한다.
#
# etcd 쿼럼 때문에 server 는 홀수여야 한다 (3, 5, 7).
# 3대면 1대가 죽어도 유지된다.
#
# 이 구성에서는 3대 모두 server 이므로 워크로드도 이 노드들이 받는다.
# ────────────────────────────────────────────────────────────────────
k3s_cluster:
  children:
    server:
      hosts:
        10.0.0.11:
        10.0.0.12:
        10.0.0.13:

    # 워커 노드를 추가할 때 주석을 풀고 IP 를 넣는다.
    # server 3대는 그대로 두고 여기에만 추가하면 된다.
    # agent:
    #   hosts:
    #     10.0.0.21:
    #     10.0.0.22:

  # k3s_cluster 그룹 전체에 적용되는 변수. 접속 정보와 k3s 설정을 여기 둔다.
  # ansible_ 로 시작하는 것은 Ansible 내장 예약 변수다 (이름 변경 불가).
  vars:
    ansible_user: myuser
    ansible_port: 22

    # 접속 환경에 따라 필요한 변수를 추가한다 (예: 키 인증)
    # ansible_ssh_private_key_file: ~/.ssh/mykey.pem

    # https://github.com/k3s-io/k3s/releases
    k3s_version: v1.36.2+k3s1

    # kubectl 과 합류하는 server 가 붙을 API 주소.
    # 기본값은 첫 server 노드라, 그 노드가 죽으면 kubectl 접속이 끊긴다
    # (etcd 쿼럼은 유지되므로 클러스터 자체는 살아있다).
    # VIP(kube-vip, HAProxy+keepalived 등)가 있으면 그 주소로 바꾼다.
    api_endpoint: "{{ hostvars[groups['server'][0]]['ansible_host'] | default(groups['server'][0]) }}"

    # 클러스터 가입 토큰.
    # 정의하지 않으면 첫 server 가 생성한 값을 collection 이 읽어서 쓴다.
    # 고정하려면 아래 주석을 풀고 값을 넣되, 평문 커밋은 피하고 vault 를 쓴다.
    #   openssl rand -base64 64
    # token: ""

    # ── k3s 부가 옵션 ──────────────────────────────────────────────────
    # k3s 옵션은 두 방식으로 넘긴다. 둘 다 collection 이 지원한다.
    # 쓸 수 있는 옵션은 k3s 공식 문서를 본다.
    #
    #   1) CLI 인자로 (server/agent 각각)
    # extra_server_args: "--disable traefik"
    # extra_agent_args: ""
    #
    #   2) config 파일로 — /etc/rancher/k3s/config.yaml 로 저장된다.
    #      collection 이 넣는 값과 병합되므로 충돌이 덜하다. 들여쓰기 유지.
    # server_config_yaml: |
    #   disable:
    #     - traefik
    # agent_config_yaml: |

    # 그 외 collection 이 받는 변수:
    #   registries_config_yaml  사설 레지스트리 (registries.yaml 로 저장)
    #   extra_install_envs      설치 스크립트 환경변수 (딕셔너리)
    #   extra_service_envs      k3s 서비스 환경변수 (리스트)
    #   airgap_dir              오프라인 설치용 아티팩트 경로
    #   extra_manifests         구축 후 적용할 로컬 매니페스트 목록

# HA 는 재실행·업그레이드 때 --forks=1 을 붙인다.
# 노드를 한 대씩 처리해서 etcd 쿼럼이 깨지지 않게 하기 위함이다.
#   uv run ansible-playbook k3s.orchestration.site -i <이 파일> --forks=1
