---
# ── 용례: k3s server 1대 (단일 노드) ─────────────────────────────────
#   cp inventories/single/hosts.yml.example inventories/single/hosts.yml
#   uv run ansible-playbook k3s.orchestration.site -i inventories/single/hosts.yml
#
# 아래에서 "collection" 은 공식 k3s.orchestration (k3s-io/k3s-ansible) 을 말한다.
# 그룹 이름(k3s_cluster / server / agent)은 collection 이 요구하는 고정 이름이라 바꾸면 안 된다.
# server 가 1대이므로 embedded etcd 없이 단일 노드로 설치된다.
# ────────────────────────────────────────────────────────────────────
k3s_cluster:
  children:
    server:
      hosts:
        10.0.0.11:

    # 워커 노드가 필요하면 주석을 풀고 IP 를 넣는다.
    # agent:
    #   hosts:
    #     10.0.0.21:
    #     10.0.0.22:

  # k3s_cluster 그룹 전체에 적용되는 변수. 접속 정보와 k3s 설정을 여기 둔다.
  # ansible_ 로 시작하는 것은 Ansible 내장 예약 변수다 (이름 변경 불가).
  vars:
    ansible_user: myuser
    ansible_port: 22

    # 접속 환경에 따라 필요한 변수를 추가한다 (예: 키 인증)
    # ansible_ssh_private_key_file: ~/.ssh/mykey.pem

    # https://github.com/k3s-io/k3s/releases
    k3s_version: v1.36.2+k3s1

    # kubectl 이 붙을 API 주소. 기본은 첫 server 노드다.
    api_endpoint: "{{ hostvars[groups['server'][0]]['ansible_host'] | default(groups['server'][0]) }}"

    # 클러스터 가입 토큰. 정의하지 않으면 첫 server 가 생성한 값을 쓴다.
    # 고정하려면 openssl rand -base64 64 로 만들되 평문 커밋은 피하고 vault 를 쓴다.
    # token: ""

    # 노드 안에서 일반 유저로 kubectl 을 쓰기 위한 설정.
    # 기본값은 true 이고 kubeconfig 를 ~/.kube/config 로 복사하는데, 그 사본은 인증서 갱신 크론이 닿지 않아 낡는다.
    # 그래서 끄고 post-k3s.yml 에서 원본을 직접 가리키게 한다.
    user_kubectl: false

    # ── k3s 옵션 ───────────────────────────────────────────────────────
    # 두 방식이 있고 k3s 가 시작할 때 병합한다(겹치면 CLI 우선).
    # 쓸 수 있는 옵션은 k3s 공식 문서를 본다.
    #
    # 1) CLI 인자 — 손으로 설치할 때 붙이던 그 자리다.
    #      curl -sfL https://get.k3s.io | sh -s - server --docker --disable traefik
    #                                                    └──── 여기 ────┘
    # extra_server_args: "--docker --disable traefik"
    # extra_agent_args: "--docker"
    #
    # 2) config 파일 — /etc/rancher/k3s/config.yaml 로 저장된다.
    #    collection 이 넣는 값과 병합되므로 옵션이 많으면 이쪽이 낫다.
    # server_config_yaml: |
    #   docker: true
    #   disable:
    #     - traefik
    #
    #   # 조직 내에서 컨테이너 대역을 배정받았으면 지정한다.
    #   # 기본값(pod 10.42.0.0/16, service 10.43.0.0/16)이 조직 내 대역과 겹치면
    #   # 파드에서 조직 내 서버로 나가는 트래픽이 가로채인다.
    #   # 아래는 임의 대역 172.31.2.0/24 를 pod 와 service 로 나눠 쓰는 예시다.
    #   cluster-cidr: 172.31.2.0/25       # pod CIDR (126개)
    #   service-cidr: 172.31.2.128/25     # service CIDR (126개)
    #   cluster-dns: 172.31.2.138         # CoreDNS ClusterIP. service-cidr 안이어야 함
    #   kube-controller-manager-arg:
    #     - "node-cidr-mask-size=27"      # pod CIDR 을 노드별로 자르는 크기
    #
    #   # /25 를 /27 로 자르면 조각이 4개 → 노드 4대까지, 노드당 파드 30개.
    #   # 5번째 노드는 대역을 못 받아 파드를 띄우지 못한다.
    #   # 기본값이 /24 라서 pod CIDR 이 /24 이하면 반드시 지정해야 한다.
    #   # (개수는 대역 크기 - 2. 네트워크·브로드캐스트 주소가 예약된다)
    # agent_config_yaml: |
    #   docker: true

    # 그 외 collection 이 받는 변수:
    #   registries_config_yaml  사설 레지스트리 (registries.yaml 로 저장)
    #   extra_install_envs      설치 스크립트 환경변수 (딕셔너리)
    #   extra_service_envs      k3s 서비스 환경변수 (리스트)
    #   airgap_dir              오프라인 설치용 아티팩트 경로
    #   extra_manifests         구축 후 적용할 로컬 매니페스트 목록
